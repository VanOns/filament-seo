parameters:
	ignoreErrors:
		-
			message: '#^Trait VanOns\\FilamentSeo\\Concerns\\HasSeoFields is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Concerns/HasSeoFields.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Http\\Kernel\:\:pushMiddleware\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/FilamentSeoServiceProvider.php

		-
			message: '#^Instanceof between Illuminate\\Routing\\Route and Illuminate\\Routing\\Route will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/SeoableRepository.php
