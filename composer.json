{
    "name": "van-ons/filament-seo",
    "description": "Add SEO functionality to Filament.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "seo"
    ],
    "homepage": "https://github.com/VanOns/filament-seo",
    "authors": [
        {
            "name": "Maurice Wijnia",
            "email": "maurice@van-ons.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.2",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.87",
        "orchestra/testbench": "^9.0|^10.0|^11.0|^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix",
        "format:check": "vendor/bin/php-cs-fixer check"
    },
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentSeo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentSeo\\FilamentSeoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
