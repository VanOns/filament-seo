{
    "name": "van-ons/filament-seo",
    "description": "Add SEO functionality to Filament.",
    "keywords": [
        "laravel",
        "filament",
        "seo"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/VanOns/filament-seo",
    "authors": [
        {
            "name": "Maurice Wijnia",
            "email": "maurice@van-ons.nl"
        },
        {
            "name": "Van Ons",
            "email": "opensource@van-ons.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "prism-php/prism": "^0.99.22|^0.100.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.87",
        "orchestra/testbench": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix",
        "format:check": "vendor/bin/php-cs-fixer check",
        "test": "vendor/bin/pest"
    },
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentSeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentSeo\\FilamentSeoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "policy": {
            "cooldown": {
                "period": "3 days",
                "ignore": {
                    "van-ons/*": "Our own packages, installed from VCS"
                }
            }
        }
    }
}
